; A text input shows the :value the page gives it. Typing calls :on-input
; with the new text, and Enter calls :on-submit. The handlers store the text
; in state, and the page runs again with it.

(define-state name "")
(define-state draft "")
(define-state todos (list "Add a text input" "Build an address bar"))

(define (without item items)
  (filter (fn (x) (not (= x item))) items))

(page :title "Inputs"
  (h1 "Hello, " (if (empty? name) "stranger" name) "!")
  (p "Your name: "
     (input :value name :placeholder "Type your name"
            :on-input (fn (text) (set! name text))))

  (h2 "To do")
  (p (input :value draft :placeholder "Something to do, then Enter" :width 300
            :on-input (fn (text) (set! draft text))
            :on-submit (fn (text)
                         (if (not (empty? text))
                             (do (set! todos (append todos (list text)))
                                 (set! draft ""))))))
  (map (fn (item)
         (p :margin 6 (button :on-click (fn () (set! todos (without item todos))) "Done") " " item))
       todos)
  (if (empty? todos) (p :color "#888" "Nothing left to do."))
  (p :color "#888" "Click an input to type in it. Tab moves to the next one, Escape leaves it."))
