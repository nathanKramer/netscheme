; Pages can't freeze or crash the browser. Each run of a page, and each
; event handler, gets a budget of evaluation steps and a limit on how deeply
; evaluation nests. Going over either stops it with an error instead.

(eval `(do ,@(source "site.sx")))

(define (forever) (forever))

(define (fib n)
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(define (count-down n)
  (if (= n 0) "done" (count-down (- n 1))))

(define-state result "nothing yet")

(demo "Runaway code"
  "Each button runs some code when clicked. The first two would never finish in reasonable time."
  (p (button :on-click (fn () (forever)) "Recurse forever")
     " " (button :on-click (fn () (set! result (fib 40))) "Compute fib 40")
     " " (button :on-click (fn () (set! result (count-down 3000))) "Recurse 3000 deep"))
  (div :background panel :padding 14 :margin 16
    (p :margin 0 "Last result: " (b result)))
  (p "The browser stops the first two and says why in a banner, and the page"
     " carries on. The third recurses deeply too, but finishes well within the"
     " limits.")
  (note "A page that loops while it loads gets the same treatment, except that"
        " the error replaces the page: " (a :href "forever.sx" "try one") "."))
