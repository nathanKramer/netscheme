(eval `(do ,@(source "site.sx")))

; The live demos on this page. Each is code kept as data, which the page
; both prints and runs.
(define counter-code
  '(do
     (define-state clicks 0)
     (define (clicker)
       (p (button :on-click (fn () (set! clicks (inc clicks))) "Click me")
          "  Clicked " (b (plural clicks "time")) "."))))
(eval counter-code)

(define greeting-code
  '(do
     (define-state name "")
     (define (greeter)
       (div
         (p :margin 8 (input :value name :placeholder "Your name"
                             :on-input (fn (text) (set! name text))))
         (p :margin 0 "Hello, " (b (if (empty? name) "stranger" name)) "!")))))
(eval greeting-code)

(define list-code
  '(do
     (define-state items (list "Read the guide"))
     (define-state draft "")
     (define (todo)
       (div
         (p :margin 8
            (input :value draft :placeholder "Something to do, then Enter"
                   :on-input (fn (text) (set! draft text))
                   :on-submit (fn (text)
                                (if (not (empty? text))
                                    (do (set! items (append items (list text)))
                                        (set! draft ""))))))
         (map (fn (item)
                (p :margin 4
                   (button :on-click (fn () (set! items (without item items))) "Done")
                   " " item))
              items)))))
(eval list-code)

(define spinner-code
  '(do
     (define-state x 0)
     (define-state running true)
     (define (spinner)
       (div
         (canvas :width 300 :height 40
                 :on-frame (if running (fn (dt) (set! x (mod (+ x (* 0.1 dt)) 300))))
                 :draw (fn () (circle :x x :y 20 :r 10)))
         (p :margin 0 (button :on-click (fn () (set! running (not running)))
                              (if running "Pause" "Play")))))))
(eval spinner-code)

(define keys-code
  '(do
     (define-state held (list))
     (define (keys)
       (canvas :width 300 :height 50 :background panel
               :on-key-down (fn (key) (set! held (append held (list key))))
               :on-key-up (fn (key) (set! held (without key held)))
         (text :x 12 :y 30 (if (empty? held) "Nothing held" (join (map repr held) " ")))))))
(eval keys-code)

(define menu-code
  '(do
     (define-state menu-open false)
     (define-state fruit "nothing yet")
     (define (fruit-menu)
       (div
         (div :width "fit" :margin 8
           (button :on-click (fn () (set! menu-open (not menu-open))) "Choose a fruit")
           (if menu-open
               (overlay :at "below" :margin-top 4 :padding 8 :radius 6
                        :background paper :border rule-colour
                        :on-dismiss (fn () (set! menu-open false))
                 (map (fn (f)
                        (p :margin 2 (a :on-click (fn () (set! fruit f) (set! menu-open false)) f)))
                      '("Apple" "Banana" "Cherry")))))
         (p :margin 0 "You chose " (b fruit) ".")))))
(eval menu-code)

(define dialog-code
  '(do
     (define-state asking false)
     (define-state answer "nothing yet")
     (define (dialog)
       (div
         (p :margin 8 (button :on-click (fn () (set! asking true)) "Ask a question"))
         (p :margin 0 "The answer: " (b answer))
         (if asking
             (overlay :at "center" :width 300 :backdrop "#0006"
                      :background paper :border rule-colour :padding 16 :radius 8
                      :on-dismiss (fn () (set! asking false))
               (p "Is this a good time?")
               (p :margin 0
                  (button :on-click (fn () (set! answer "yes") (set! asking false)) "Yes")
                  " "
                  (button :on-click (fn () (set! answer "no") (set! asking false)) "No"))))))))
(eval dialog-code)

(define (live code view)
  (div :margin 18
    (show-code code)
    (div :background rule-colour :padding 1
      (div :background paper :padding 16
        (p :margin 8 :size 12 :bold true :color faint "LIVE")
        view))))

(chapter "state.sx"
  (section "State")
  (p "A variable defined with " (code "define-state") " keeps its value when the"
     " page runs again. The value after its name is only used the first time."
     " Change it with " (code "set!") ", usually from an event handler.")
  (p "Here's a counter. This page defines it by evaluating the quoted code"
     " below, so the code you see is exactly the code that's running:")
  (live counter-code (clicker))

  (section "Events")
  (p "Any element can have an " (code ":on-click") " handler: a function that"
     " takes no arguments. Buttons are the usual place for one, but a"
     " " (code "div") " or a " (code "span") " can be clicked too.")
  (p "After a handler runs, the browser runs the " (b "whole page") " again. The new"
     " values of the state variables give a new document, which replaces the old"
     " one. Nothing edits the page in place.")
  (note "This is the same idea as React: the page is a function of its state."
        " It also means a handler doesn't need to know what on the page depends on"
        " what it changed.")

  (section "Text inputs")
  (p "An " (code "input") " shows the text in its " (code ":value") ". Typing calls"
     " " (code ":on-input") " with the new text, and the handler decides what to"
     " keep, usually by storing it in state. Enter calls " (code ":on-submit") ".")
  (live greeting-code (greeter))
  (p "Without an " (code ":on-input") " handler, typing changes nothing, as with"
     " React's controlled inputs. The browser itself only keeps track of which input"
     " has focus, where the caret is, and what's selected.")
  (p "Inputs have " (code ":placeholder") " text for when they're empty, and a"
     " " (code ":width") " in pixels. Click one to focus it. Arrow keys, Home, End,"
     " Backspace and Delete edit; Tab moves to the next input; Escape, or a click"
     " somewhere else, leaves it.")
  (p "To select text in an input, drag across it, double-click a word,"
     " triple-click for all of it, hold Shift with the arrow keys or Home and End,"
     " or press Ctrl+A. Typing, Backspace and Delete replace the selection. With "
     (code ":select-on-focus true") ", a click that focuses the input selects all"
     " its text, as the address bar does. Tab, and Ctrl+L for the address bar,"
     " select everything in the input they move to.")
  (p "A few more attributes make an input behave like a control. "
     (code ":autofocus true") " focuses it when it first appears. "
     (code ":on-escape") " runs when Escape leaves it, and " (code ":on-shift-submit")
     " runs instead of " (code ":on-submit") " for Shift+Enter. The toolbar's find"
     " bar, which Ctrl+F opens, uses all three.")
  (subsection "A to-do list")
  (p "Put state, inputs and lists together and you have an app:")
  (live list-code (todo))

  (section "Animation")
  (p "An " (code ":on-frame") " handler is called sixty times a second, with the"
     " milliseconds since the last frame, and then the page runs again, as it"
     " does after a click. Multiplying a speed by that time keeps things moving"
     " at the same pace when a frame comes late. " (code ":on-frame nil")
     " is no handler, so " (code "(if running (fn (dt) ...))") " can pause.")
  (live spinner-code (spinner))
  (p "This canvas draws its circle with a " (code ":draw") " function, which the"
     " browser calls after the page runs, rather than the page drawing it as it"
     " runs. The browser notices which state the page reads, and which state a"
     " handler changes. When a frame only changes " (code "x") ", which only "
     (code ":draw") " reads, running the page again would make the same page, so"
     " the browser just calls " (code ":draw") " again. Clicking Pause changes "
     (code "running") ", which the page reads, so the page runs again. Either way,"
     " what you see is the same.")
  (p "A handler that fails stops the animation, so the error can be read,"
     " until the page is loaded again. The " (a :href "canvas.sx" "canvas demo")
     " has balls bouncing around a box.")

  (subsection "What happens in a frame")
  (entry "Scheduling" "After every event, the browser checks whether any element,"
         " in the page or a page framed in it, has an " (code ":on-frame") " handler."
         " If one does, the next frame is due 16.7ms after the last. If none does,"
         " the window sleeps until the next event.")
  (entry "Timing" (code "dt") " is the time since the last frame actually ran, in"
         " milliseconds, and at most 100. A late frame isn't made up for with extra"
         " frames: one frame runs, with a larger " (code "dt") ". While nothing has a"
         " handler, such as while paused, the clock stops, so the first frame after"
         " resuming gets about 16.7, not the length of the pause.")
  (entry "Handlers" "The browser calls every " (code ":on-frame") " handler in the"
         " page as it was last built, framed pages included, in the order their"
         " elements appear, each with the same " (code "dt") ". A later handler sees"
         " what an earlier one set.")
  (entry "Afterwards" "Once they've all run, the browser decides what to redo, as"
         " after a click: run the page again, call only the " (code ":draw")
         " functions, or nothing. The page runs at most once per frame, however many"
         " handlers there are. A handler that calls " (code "go") " goes there instead.")
  (p "Because handlers come from the page as last built, a handler that sets "
     (code "running") " to false still runs that frame. Its element has "
     (code ":on-frame nil") " from the next frame on.")
  (p "The browser works out what to redo from which state the page reads, and"
     " which state handlers change. Changing a global variable that isn't state,"
     " or dark mode, the find bar or the REPL, always runs the page again. This"
     " applies after every event, not just frames.")
  (p "The window doesn't animate while it's hidden, and when it's shown again,"
     " the first frame's " (code "dt") " is 100. When a handler fails, the ones"
     " after it don't run that frame, and what earlier ones set is kept. Each frame"
     " has the same budget as any other event.")

  (section "Keys")
  (p "A canvas with " (code ":on-key-down") " or " (code ":on-key-up") " takes the"
     " keyboard when it's clicked, until Escape or a click somewhere else. The"
     " handlers get the key's name: " (code "\"a\"") ", " (code "\" \"") " for Space, "
     (code "\"ArrowLeft\"") ", " (code "\"Enter\"") " and so on. Holding a key calls "
     (code ":on-key-down") " once, and every key that goes down comes back up, even"
     " if the canvas loses the keyboard first, so a page can keep track of which"
     " keys are held. Click this one and press some keys:")
  (live keys-code (keys))
  (p "Names are as the web's " (code "KeyboardEvent.key") " gives them, but as if"
     " Shift weren't held, so Shift+A is " (code "\"a\"") ", and Shift itself is "
     (code "\"Shift\"") ". A canvas with the keyboard shows a focus outline, and"
     " arrow keys and Space stop scrolling the page. Its held keys get "
     (code ":on-key-up") " when it loses the keyboard, when the window loses focus,"
     " and when you follow a link or go back.")
  (p "Keys with Ctrl, Alt or Super, and function keys like F5, still go to the"
     " browser. " (a :href "snake.sx" "Snake") " puts keys and animation together.")

  (section "Overlays")
  (p "An " (code "overlay") " is drawn over the page instead of taking up room in"
     " it, for menus, tooltips, dialogs and notices. It's anchored to the block it's"
     " written in, and " (code ":at") " puts it " (code "\"below\"") " that block, which"
     " is the default, " (code "\"above\"") ", or to its " (code "\"left\"") " or "
     (code "\"right\"") ". If there's more room on the other side, it goes there"
     " instead, so a menu near the bottom of the window opens upwards. Without a "
     (code ":width") ", it's as wide as its content.")
  (live menu-code (fruit-menu))
  (p "At " (code "\"center\"") ", " (code "\"top\"") ", " (code "\"bottom\"")
     ", or a corner like " (code "\"bottom-right\"") ", an overlay is placed in the"
     " window instead, and stays put as the page scrolls. A " (code ":backdrop")
     " colour covers the page beneath it, and a " (code ":margin") " keeps it off the"
     " window's edges.")
  (live dialog-code (dialog))
  (p "Clicks on an overlay go to it, not to what's under it. An overlay with an "
     (code ":on-dismiss") " handler is told when there's a click outside it, or"
     " Escape is pressed, and the click does nothing else, so clicking away from a"
     " menu closes it rather than following a link that was under the pointer."
     " The handler usually sets the state that shows the overlay to false.")
  (p "An overlay is laid out with the page it's on, after the rest of it, so later"
     " overlays go over earlier ones, and one in a frame stays inside the frame.")

  (section "Where state lives")
  (p "State belongs to the page and lasts while you're on it. Each "
     (code "define-state") " is identified by its order in the page, so state"
     " should be defined at the top level, the same way every time the page runs."
     " Following a link starts the new page with fresh state, going back to a page"
     " restores the state it had, and reloading, with F5 or Ctrl+R, starts it over.")
  (p "Each frame keeps its own state, keyed by its position among the frames, so"
     " two frames of the same page count separately.")
  (p "For more, see the " (a :href "counter.sx" "counter") " and "
     (a :href "inputs.sx" "text inputs") " demos."))
