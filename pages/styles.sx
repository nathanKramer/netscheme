(eval `(do ,@(source "site.sx")))

; Styles this chapter defines and shows, kept as code so it can print them.
(define styles-code
  '(do
     (define warm (light-dark "#b85a1a" "#f2ab73"))
     (define callout (style :background (light-dark "#fff1d6" "#3d2f1c") :padding 12 :margin 8))
     (define loud (style :color warm :bold true :size 20))))
(eval styles-code)

(chapter "styles.sx"
  (section "Style attributes")
  (p "Elements are styled with attributes. There are no stylesheets and no"
     " selectors: each element says how it looks.")
  (entry ":color \"#5b3ab8\"" "Text colour, as " (code "#rgb") ", " (code "#rrggbb")
         " or one of a few names like " (code "red") ". Children inherit it. "
         (code "#rgba") " and " (code "#rrggbbaa") " are see-through: " (code "#ffffff10")
         " lightens whatever is behind it a little.")
  (entry ":background \"#f3eef7\"" "Fills the element's box.")
  (entry ":size 20" "Font size in pixels. Inherited.")
  (entry ":font \"Open Sans\"" "The typeface. The default is Liberation Sans, which "
         (code "\"system-ui\"") " and " (code "\"sans-serif\"") " also name. Open Sans"
         " comes with the browser too. Inherited.")
  (entry ":weight 800" "How heavy the text is, from 100 to 900, where 400 is regular."
         " Open Sans has 400, 500, 600, 700 and 800, and Liberation 400 and 700; other"
         " weights use the nearest. Inherited.")
  (entry ":bold true" "Weight 700, or 400 for " (code "false") ". Inherited.")
  (entry ":mono true" "Monospaced text, as in " (code "code") ". Inherited.")
  (entry ":underline true" "Underlined text. Inherited.")
  (entry ":line-height 1.5" "The height of a line, as a multiple of the font size. The"
         " default is 1.3. Inherited.")
  (entry ":padding 12" "Space inside the box, on every side. On inline elements, on the left and right.")
  (entry ":padding-left 24" "Space inside on one side, after " (code ":padding") "."
         " " (code ":padding-top") ", " (code ":padding-right") " and " (code ":padding-bottom")
         " are the others; inline elements only use the left.")
  (entry ":margin 16" "Space below a block, before whatever comes next. "
         (code ":margin-bottom") " is the same.")
  (entry ":margin-top 16" "Space above a block.")
  (entry ":width 300" "How wide a block is, instead of the width it's in. "
         (code "\"fit\"") " makes it as wide as its content. Then " (code ":align \"right\"")
         " or " (code "\"center\"") " places it.")
  (entry ":border \"#d0c8dc\"" "A line just inside the box's edge, which follows "
         (code ":radius") ". " (code ":border-width") " sets how thick, 1 by default.")
  (entry ":max-width 720" "The widest the content may be. Narrower content is centred, and the"
         " background still fills the whole box. These pages use it on " (code "page") ".")
  (entry ":radius 8" "Rounds the corners of the element's background, or of an " (code "img") "."
         " It's capped at half the shorter side, so a big one like " (code "999")
         " makes a square image a circle and a wide box a pill. Click areas stay square.")
  (example
    '(div :background (light-dark "#e8f1fb" "#1f2530") :padding 16
       (p :size 20 :bold true :margin 6 "A heading of sorts")
       (p :margin 0 :color (light-dark "#555" "#aaa") "With a quieter line below.")))
  (example
    '(div :width "fit" :align "right" :border (light-dark "#d0c8dc" "#4a4454") :radius 8 :padding 12
       (p :margin 0 :font "Open Sans" :weight 800 :size 20 "Shrunk to fit, on the right")))
  (example
    '(div :background (light-dark "#e8f1fb" "#1f2530") :padding 16 :radius 12
       (p :margin 0 (span :background warm :color "#fff" :padding 8 :radius 999 :bold true "new")
          " a pill, in a box with rounded corners.")))

  (section "Hover")
  (p (code ":hover") " takes a style that a block has while the pointer is over it."
     " A block that's a " (code ":group") " gives its children their "
     (code ":group-hover") " styles while it's hovered, so a card can change its"
     " title as well as its border:")
  (example
    '(div :group true :border (light-dark "#d0c8dc" "#4a4454") :radius 8 :padding 12
          :hover (style :border warm)
       (p :margin 0 :bold true :group-hover (style :color warm) "Point at this card")
       (p :margin 0 "Its border and its title change colour.")))

  (section "Styles are values")
  (p "The " (code "style") " function takes attributes and returns them as a list."
     " Put that list in an element and it's spliced in, just like children that"
     " come from a " (code "map") ". So a style is a value you can name, pass"
     " around and compute:")
  (show-code styles-code)
  (gap 8)
  (example
    '(div callout
       (p :margin 0 "A callout with some " (span loud "loud") " words.")))

  (subsection "Combining styles")
  (p "Combining two styles is " (code "append") ", because they're lists. When an"
     " attribute appears twice the later one wins, so put the style you want to"
     " take priority last:")
  (example
    '(div (append callout (style :background (light-dark "#e3f4e6" "#212a22")))
       (p :margin 0 "The callout's padding and margin, with a green background.")))

  (subsection "Styles in components")
  (p "A component that passes its arguments through, with " (code "&") ", lets"
     " whoever calls it add attributes that override its own:")
  (example
    '(let ((badge (fn (& body)
                    (span :background warm :color "#fff" :padding 6 :bold true body))))
       (p (badge "new") " " (badge :background "#2a7a3a" "done") " " (badge :size 12 "small"))))

  (section "Dark mode")
  (p "The browser has a dark mode, which the toolbar's button switches. Pages"
     " that pick no colours of their own follow it automatically. A page that"
     " does pick colours can ask which mode is on:")
  (entry "(dark-mode)" "True when the browser is in dark mode.")
  (entry "(light-dark light dark)" "Whichever of its arguments suits the mode, like CSS's"
         " function of the same name. It works on any value, not just colours.")
  (example
    '(p "This browser is in " (b (if (dark-mode) "dark" "light")) " mode, so this is "
        (span :color (light-dark "#b8336a" "#f07aa8") "pink for it") "."))
  (note "Every colour on these pages comes from a " (code "light-dark") " in "
        (code "site.sx") ". Switch modes in the toolbar to see them change."))
