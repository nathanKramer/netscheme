(eval `(do ,@(source "site.sx")))

; A component this chapter defines, prints and uses. It's kept as data so
; the page can show its code, and `eval` defines it.
(define card-code
  '(define (card title & body)
     (div :background (light-dark "#f3eef7" "#2a2631") :padding 14 :margin 10
       (b :size 18 title)
       body)))
(eval card-code)

(chapter "tour.sx"
  (section "A page is a program")
  (p "A Netscheme page is a file of Lisp code, usually ending in " (code ".sx")
     ". The browser runs the whole file, top to bottom, and the value of the"
     " last expression is the page. Here's a complete one:")
  (code-block
"; Definitions come first, then the page itself.
(define who \"world\")

(page :title \"Greetings\"
  (h1 \"Hello, \" who \"!\")
  (p \"This is a whole page.\"))")
  (p "Save that as " (code "greetings.sx") " and open it with "
     (code "cargo run -- greetings.sx") ", or type its path into the address bar.")

  (section "Elements are functions")
  (p "Each element is an ordinary function. Its arguments are attributes,"
     " which come in pairs of a " (code ":keyword") " and a value, and children,"
     " which are text or other elements:")
  (example
    '(p :color (light-dark "#2a7a3a" "#7fd38c")
        "A paragraph with " (b "bold") " and " (span :size 22 "bigger") " text."))
  (p "These are the elements there are:")
  (entry "page" "The whole document. It takes " (code ":title") ", and styles that apply to everything.")
  (entry "div, row" "Boxes that stack their children. A " (code "row")
         " puts its children side by side, " (code ":gap") " apart (16 unless it says)."
         " A child with a " (code ":width") " keeps it, inline children and those with "
         (code ":width \"fit\"") " are as wide as their content, and the rest, including"
         " inputs with " (code ":width :fill") ", and any "
         (code "spacer") ", share the room left equally. " (code ":align \"middle\"")
         " or " (code "\"bottom\"") " lines the columns up other than at the top.")
  (entry "h1, h2, h3, p, pre" "Headings, paragraphs, and preformatted code that keeps its spaces and line breaks.")
  (entry "span, b, code, a, button, input, img, canvas" "Inline elements, which flow along a line of text and wrap with it.")
  (entry "spacer" "Takes up whatever room is left on its line, pushing what follows"
         " to the end. The toolbar uses one to put the mode switch at its right-hand end.")
  (entry "rect, circle, line, polyline, polygon, path, text" "Shapes, drawn inside a " (code "canvas") ".")
  (entry "frame" "Another page, shown inside this one. See " (a :href "code-as-data.sx" "Code is data") ".")
  (entry "overlay" "Drawn over the page, next to the block it's in or fixed in the"
         " window, for menus and dialogs. See " (a :href "state.sx" "State and events") ".")

  (section "Children can be anything")
  (p "Numbers become text. " (code "nil") " is skipped, so an " (code "if")
     " without an else branch can leave something out. And lists are spliced in,"
     " so a " (code "map") " can produce several children:")
  (example
    '(div
       (p "Six times seven is " (* 6 7) ".")
       (p "Today is " (if false "a holiday") "an ordinary day.")
       (map (fn (fruit) (p "• " fruit)) '("apple" "banana" "cherry"))))

  (section "Components are functions too")
  (p "Since elements are functions, a component is just a function that returns"
     " elements. This chapter defines one:")
  (show-code card-code)
  (gap 8)
  (p "The " (code "&") " collects the rest of the arguments into " (code "body")
     ", so a card can take any number of children, and attributes too. Using it"
     " looks just like using a built-in element:")
  (example
    '(div
       (card "A card" (p :margin 0 "With a paragraph inside."))
       (card "Another" :background (light-dark "#fff1d6" "#3d2f1c")
             (p :margin 0 "This one passes its own " (code ":background") "."))))
  (note "When an attribute is given twice, the later one wins. That's how the"
        " second card's background replaces the one " (code "card") " sets.")

  (section "Images")
  (p "An " (code "img") " shows a PNG image from its " (code ":src") ", a location"
     " relative to the page like a link's. Give it a " (code ":width") " or a "
     (code ":height") " and it keeps its proportions; give neither and it's its"
     " natural size. Images sit on the line like letters do, or centred on the"
     " text beside them with " (code ":align \"middle\"") ":")
  (example
    '(p (img :src logo :width 24 :align "middle") " small, "
        (img :src logo :width 48 :align "middle") " medium, and "
        (img :src logo :width 96 :align "middle") " large."))
  (p "With " (code ":width :fill") " an image is as wide as the block it's in,"
     " and keeps its proportions as the window resizes. A " (code ":height")
     " as well stretches it to that height:")
  (example
    '(div :max-width 160 (img :src logo :width :fill)))
  (p "An image inside an " (code "a") " is a link. One that can't be loaded"
     " keeps its space as an empty box, and the reason is printed to the terminal.")
  (p "Images can be files or on the web, but pages from the web can only load"
     " images from the web. Images at " (code "browser:") " locations, like the"
     " toolbar's " (code "browser:icons/moon.png") ", come from the browser's "
     (code "ui") " folder. A file can be up to 16 MB, and 4096 × 4096 pixels once"
     " decoded. Each image is decoded once and kept, along with copies scaled to"
     " the sizes it's drawn at, until a reload.")

  (section "Drawing")
  (p "A " (code "canvas") " is a box, " (code ":width") " by " (code ":height") ", that"
     " draws the shapes inside it. They're elements like any other, so " (code "map")
     " can make them and " (code ":on-click") " works on each one. Coordinates are"
     " measured from the canvas's top-left corner, and shapes outside it are cut off:")
  (example
    '(canvas :width 300 :height 80 :background (light-dark "#f4f1f8" "#25222b")
       (rect :x 10 :y 10 :w 60 :h 60 :fill "#b8336a")
       (circle :x 120 :y 40 :r 30 :stroke "#5b3ab8" :stroke-width 4)
       (line :x1 170 :y1 70 :x2 220 :y2 10 :stroke-width 3)
       (map (fn (i) (circle :x (+ 240 (* i 14)) :y 40 :r (+ 2 i))) (range 4))))
  (p "Shapes are filled with " (code ":fill") " and outlined with " (code ":stroke")
     " and " (code ":stroke-width") ". Given neither, they're filled in the text colour,"
     " and lines are drawn in it, so they follow dark mode. "
     (code "(polygon :points '((0 0) (40 0) (20 30)))") " joins points and fills them,"
     " and a " (code "polyline") " only draws the line through them. "
     (code "(path :d \"M12 2 L22 22 H2 Z\")") " takes SVG path data, curves and arcs"
     " included, so icons can be copied from SVG files; " (code ":scale") " resizes it"
     " and " (code ":x") " and " (code ":y") " move it. "
     (code "(text :x 10 :y 20 \"hi\")") " puts text with its baseline at "
     (code ":y") ", and takes the usual text attributes. See "
     (a :href "canvas.sx" "the canvas demo") " for more.")
  (p "A canvas is 300 × 150 unless it's given a size. A stroke is centred on the"
     " shape's edge, and corners where a stroked line bends are rounded. A click"
     " lands on a shape anywhere in the box around it, and a shape drawn later is"
     " clicked first. Children of a canvas that aren't shapes are left out.")
  (p "A canvas's " (code ":draw") " is a function of no arguments that returns more"
     " shapes. The browser calls it after the page runs, and draws what it returns"
     " after the canvas's children. " (a :href "state.sx" "State and events")
     " explains why that's useful for animation.")

  (section "Links")
  (p "An " (code "a") " element with an " (code ":href") " goes to another page when"
     " clicked. Relative locations are resolved against the current page, like"
     " on the web, and " (code "http://") " and " (code "https://") " links download"
     " pages from servers. On a page that's a file, a location starting with "
     (code "/") " is relative to the folder the browser was started in. Alt+← goes back.")
  (example '(p "Read on: " (a :href "styles.sx" "styles are values") "."))
  (p "A location can end in " (code "#") " and a name, as in " (code "page.sx#intro")
     ". Opening it scrolls the block with that " (code ":id") ", like "
     (code "(div :id \"intro\" ...)") ", to the top. A link with "
     (code ":ctrl-click true") " is only a link, and underlined, while Ctrl is held: a plain click"
     " selects its text instead. View source uses both, to go to definitions."))
