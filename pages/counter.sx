; State that survives the page running again. Clicking a button runs its
; handler, which changes some state with `set!`. The browser then runs this
; whole file again, and the page shows the new values.

(eval `(do ,@(source "site.sx")))

(define-state count 0)
(define-state colour 0)
(define-state open false)

(define colours
  (light-dark (list "#b8336a" "#5b3ab8" "#2a7a3a" "#b85a1a")
              (list "#f07aa8" "#c3a6ff" "#86d993" "#f2ab73")))

(demo (str "Counter: " count)
  "The smallest interactive page: three pieces of state, and buttons that change them."

  (div :background panel :padding 24 :margin 16
    (p :margin 18 :size 56 :bold true :color (nth colours colour) count)
    (p :margin 0
       (button :on-click (fn () (set! count (inc count))) "Click me")
       " " (button :on-click (fn () (set! count 0)) "Reset")
       " " (button :on-click (fn () (set! colour (mod (inc colour) (length colours)))) "Change colour")))
  (p muted "Clicked " (plural count "time") " so far.")

  ; Any element can be clicked, not just buttons.
  (div :background accent :padding-left 3 :margin 16 :on-click (fn () (set! open (not open)))
    (div :background panel :padding 14
      (p :margin (if open 10 0) (b (if open "▼ Hide" "► Show")) " how this works (click anywhere here)")
      (if open
          (div
            (p :margin 10 "Each " (code "define-state") " variable keeps its value when the"
               " page runs again. Its initial value is only used the first time.")
            (p :margin 0 "A click runs the handler, then the browser runs the page again"
               " from the top and draws it afresh. Nothing edits the page in place."))))))
