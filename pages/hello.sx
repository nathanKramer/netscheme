; The home page. Like every page here, it's a program: it loads the site's
; shared code, and its last value is the document to show.

(eval `(do ,@(source "site.sx")))

(site-page "Welcome"
  (p :margin 6 (img :src logo :width 128 :alt "The Netscheme logo: a globe between parentheses, with a lambda"))
  (p :margin 6 eyebrow "A TOY WEB BROWSER")
  (h1 :size 48 :margin 14 :color accent "Netscheme")
  (p :margin 14 lede
     "Netscheme pages are Lisp programs."
     " A single language governs structure, style, and behaviour.")
  (p "There's no HTML, no CSS and no JavaScript. Elements are functions,"
     " styles are values, and a page that responds to clicks is just a page"
     " whose code reads some state. Here's a small one, and what it makes:")

  (example
    '(div
       (h2 :color (light-dark "#b8336a" "#f07aa8") "Hello, world!")
       (p "The squares of one to seven are "
          (interpose ", " (map (fn (n) (b (* n n))) (range 1 8)))
          ".")))

  (p "The code above is a quoted list. This page prints it, then evaluates it"
     " to get the element below, so the example can't drift from what it shows.")

  (section "The guide")
  (p muted "Start at the beginning, or jump to what you're curious about.")
  (contents chapters true)

  (section "Demos")
  (p muted "Pages that show off one idea each. Open one, then View source to see how it works.")
  (contents demos false))
